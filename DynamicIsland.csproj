<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Version>1.2.0</Version>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
    <AssemblyTitle>Dynamic Island</AssemblyTitle>
    <Product>Dynamic Island</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous (Brush, Color, Point, Clipboard...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\island.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generates exact Win32/COM bindings (Media Foundation sensor monitor, Core Audio) from Microsoft's metadata. -->
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.*" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
