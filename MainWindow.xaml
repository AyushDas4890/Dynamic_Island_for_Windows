<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island" Width="780" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="Secondary" Color="#8EFFFFFF" />
        <SolidColorBrush x:Key="TimerAccent" Color="#30D158" />
        <SolidColorBrush x:Key="TimerAccentDim" Color="#0F3B1E" />
        <SolidColorBrush x:Key="ChargeGreen" Color="#30D158" />
        <SolidColorBrush x:Key="Fill" Color="#2C2C2E" />
        <SolidColorBrush x:Key="AgentCoral" Color="#FF8A70" />
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <!-- Island surface: near-black on the left fading into deep plum on the right. -->
        <LinearGradientBrush x:Key="IslandFill" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#0F1115" Offset="0" />
            <GradientStop Color="#121217" Offset="0.38" />
            <GradientStop Color="#1D1621" Offset="0.58" />
            <GradientStop Color="#33192F" Offset="0.8" />
            <GradientStop Color="#4B1F4D" Offset="1" />
        </LinearGradientBrush>

        <!-- Round tap target: press feedback is wired in code (scale on pointer-down). -->
        <Style x:Key="Circle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Bar" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="13" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="Margin" Value="1.25,0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
    </Window.Resources>

    <Canvas x:Name="Root">

        <!-- Near-invisible hover strip around the idle sliver (alpha 1 still receives the mouse). -->
        <Border x:Name="HitZone" Background="#01000000" Width="110" Height="12" Canvas.Top="0" Canvas.Left="335" />

        <!-- State glow behind the island (orange = Claude working, green = done, blue = idle). -->
        <Border x:Name="Glow" Background="Black" Width="126" Height="34" CornerRadius="0,0,17,17" Canvas.Top="0" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect x:Name="GlowShadow" ShadowDepth="0" BlurRadius="26" Opacity="0.85" Color="#FF9A3C" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <!-- ================= MAIN ISLAND ================= -->
        <Border x:Name="Island" Background="Black" BorderThickness="1.2,0,1.2,1.2" BorderBrush="#33FF9A3C" Width="126" Height="34" CornerRadius="0,0,17,17"
                Canvas.Top="0" ClipToBounds="True">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScale" />
            </Border.RenderTransform>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="NotificationStatusItem" Header="Notifications: starting…" IsEnabled="False" />
                    <MenuItem Header="Forget Anthropic API key" Click="ForgetKey_Click" />
                    <MenuItem Header="Quit Dynamic Island" Click="Quit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- SLIVER (resting while something runs): activity dots only -->
                <!-- NOTCH (resting): the robot, with activity dots either side -->
                <Grid x:Name="SliverView" Width="150" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Ellipse x:Name="MusicDot" Width="5" Height="5" Fill="White" Margin="2,0" />
                        <Ellipse x:Name="TimerDot" Width="5" Height="5" Fill="{StaticResource TimerAccent}" Margin="2,0" />
                    </StackPanel>
                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Mascot x:Name="NotchMascot" />
                    </Viewbox>
                    <!-- Privacy indicators, iPhone colours: green = camera, orange = microphone -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse x:Name="AgentDot" Width="5" Height="5" Fill="{StaticResource AgentCoral}" Margin="2,0" />
                        <Ellipse x:Name="CamDot" Width="5" Height="5" Fill="#30D158" Margin="2,0" />
                        <Ellipse x:Name="MicDot" Width="5" Height="5" Fill="#FF9F0A" Margin="2,0" />
                    </StackPanel>
                </Grid>

                <!-- DASHBOARD (hover): toolbar, Claude Code card, four tiles -->
                <Grid x:Name="DashView" Width="720" Height="214" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="20,10,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- toolbar -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="TbHome" Style="{StaticResource Circle}" Width="30" Height="30" CornerRadius="15" Background="Transparent" ToolTip="Open Dynamic Island">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE80F;" />
                            </Border>
                            <Border x:Name="TbAsk" Style="{StaticResource Circle}" Width="30" Height="30" CornerRadius="15" Background="Transparent" Margin="6,0,0,0" ToolTip="Ask Claude about the window behind">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE710;" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="TbSound" Style="{StaticResource Circle}" Width="30" Height="30" CornerRadius="15" Background="Transparent" ToolTip="Sounds on/off">
                                <TextBlock x:Name="TbSoundGlyph" Style="{StaticResource Glyph}" FontSize="14" Text="&#xE767;" />
                            </Border>
                            <Border x:Name="TbSettings" Style="{StaticResource Circle}" Width="30" Height="30" CornerRadius="15" Background="Transparent" Margin="6,0,0,0" ToolTip="Settings">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE713;" />
                            </Border>
                            <Border x:Name="TbCollapse" Style="{StaticResource Circle}" Width="30" Height="30" CornerRadius="15" Background="Transparent" Margin="6,0,0,0" ToolTip="Close">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE70E;" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Claude Code card -->
                            <Border Background="#141518" CornerRadius="16" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox x:Name="DashMascotHost" Width="64" Height="64" VerticalAlignment="Center" Cursor="Hand">
                                        <local:Mascot x:Name="DashMascot" />
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="DashStateDot" Width="7" Height="7" Fill="#FF9A3C" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DashProject" Text="Claude Code" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                                                <TextBlock x:Name="DashAgentName" Text="Claude Code" FontSize="11.5" Foreground="#6E727B" Margin="7,1,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="DashCount" HorizontalAlignment="Right" FontSize="11" Foreground="#6E727B" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock x:Name="DashStatusGlyph" Style="{StaticResource Glyph}" FontSize="12" Foreground="#FF9A3C" Text="&#xE895;" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform><RotateTransform x:Name="DashSpin" /></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="DashStatus" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" Text="Waiting for Claude Code" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Background="#0B0C0F" CornerRadius="10" Padding="9,7" Margin="0,8,0,0" Height="74">
                                            <StackPanel>
                                                <TextBlock x:Name="DashFile" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="#5AA9FF" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="DashLineA" FontFamily="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0" Padding="4,1" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="DashLineB" FontFamily="{StaticResource Mono}" FontSize="11" Margin="0,2,0,0" Padding="4,1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- tiles -->
                            <UniformGrid Grid.Column="2" Rows="2" Columns="2">
                                <Border x:Name="TileMusic" Background="#141518" CornerRadius="14" Margin="0,0,5,5" Padding="12,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="TileMusicArt" Width="34" Height="34" CornerRadius="9" Background="#1DB954">
                                            <TextBlock x:Name="TileMusicGlyph" Style="{StaticResource Glyph}" FontSize="15" Foreground="#06200F" Text="&#xE8D6;" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Width="100">
                                            <TextBlock x:Name="TileMusicTitle" FontSize="12.5" FontWeight="SemiBold" Text="Music" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="TileMusicSub" FontSize="11" Foreground="#6E727B" Text="Nothing playing" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="TileTimer" Background="#141518" CornerRadius="14" Margin="5,0,0,5" Padding="12,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="34" Height="34">
                                            <Ellipse Stroke="#2A2620" StrokeThickness="3" />
                                            <Path x:Name="TileTimerRing" Stroke="#FF9A3C" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Foreground="#FF9A3C" Text="&#xE916;" />
                                        </Grid>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TileTimerText" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Text="25:00" />
                                            <TextBlock x:Name="TileTimerSub" FontSize="11" Foreground="#6E727B" Text="Focus" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#141518" CornerRadius="14" Margin="0,5,5,0" Padding="14,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TileClock" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Text="14:36" />
                                        <TextBlock x:Name="TileDate" FontSize="11" Foreground="#6E727B" Text="Mon 12 Oct" />
                                        <Grid Width="80" Height="2.5" HorizontalAlignment="Left" Margin="0,5,0,0">
                                            <Border CornerRadius="1.25" Background="#24262D" />
                                            <Border x:Name="TileDayFill" CornerRadius="1.25" Background="#5A6CFF" HorizontalAlignment="Left" Width="40" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="TileSettings" Background="#141518" CornerRadius="14" Margin="5,5,0,0" Padding="12,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="9">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#B58CFF" Offset="0" />
                                                    <GradientStop Color="#7A4DFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Viewbox Width="24" Height="24"><local:Mascot x:Name="SettingsMascot" /></Viewbox>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="Settings" />
                                            <TextBlock FontSize="11" Foreground="#6E727B" Text="Colours, sound" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- HOME (expanded, nothing running): clock + timer presets -->
                <Grid x:Name="HomeView" Width="400" Height="76" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border x:Name="HomeMascotHost" Width="40" Height="40" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="Transparent" Cursor="Hand" ToolTip="Click to ask about the window behind, or drag me onto any window">
                        <local:Mascot x:Name="HomeMascot" />
                    </Border>
                    <StackPanel Margin="70,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" FontFamily="{StaticResource Display}" FontSize="25" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" Text="10:42" />
                        <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource Secondary}" Margin="1,-2,0,0" Text="Wednesday, 18 November" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Border x:Name="Preset1" Style="{StaticResource Circle}" Background="{StaticResource TimerAccentDim}" Tag="1">
                            <TextBlock Text="1m" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TimerAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Preset5" Style="{StaticResource Circle}" Background="{StaticResource TimerAccentDim}" Tag="5" Margin="8,0">
                            <TextBlock Text="5m" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TimerAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Preset25" Style="{StaticResource Circle}" Background="{StaticResource TimerAccentDim}" Tag="25">
                            <TextBlock Text="25m" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TimerAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- CHARGING ALERT (compact-width, like iOS) -->
                <Grid x:Name="ChargingView" Width="300" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Path Data="M5.2,0 L0,7.4 H3.4 L2.4,13 L7.8,5.2 H4.4 Z" Fill="{StaticResource ChargeGreen}" VerticalAlignment="Center" />
                        <TextBlock Text="Charging" Margin="7,0,0,0" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource ChargeGreen}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,15,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ChargePercent" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource ChargeGreen}"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Text="80%" />
                        <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border Width="27" Height="13" CornerRadius="4" BorderBrush="#5AFFFFFF" BorderThickness="1" Padding="1.5">
                                <Border x:Name="ChargeFill" HorizontalAlignment="Left" Width="18" CornerRadius="2.5" Background="{StaticResource ChargeGreen}" />
                            </Border>
                            <Border Width="2" Height="5" CornerRadius="1" Background="#5AFFFFFF" HorizontalAlignment="Right" Margin="0,0,-3.5,0" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- PILL ALERT: clipboard, Bluetooth (compact-width) -->
                <Grid x:Name="PillView" Width="300" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PillGlyph" Style="{StaticResource Glyph}" Margin="14,0,0,0" FontSize="15" Text="&#xE8C8;" />
                    <TextBlock x:Name="PillTitle" Grid.Column="1" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="Copied" />
                    <TextBlock x:Name="PillValue" Grid.Column="2" Margin="12,0,15,0" FontSize="12" Foreground="{StaticResource Secondary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- NOTIFICATION: app icon, app name, title, body -->
                <Grid x:Name="NoticeView" Width="372" Height="72" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="NoticeIcon" Width="38" Height="38" CornerRadius="10" Margin="17,0,0,0" Background="{StaticResource Fill}">
                        <TextBlock x:Name="NoticeGlyph" Style="{StaticResource Glyph}" FontSize="20" Text="&#xEA8F;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,24,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NoticeApp" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NoticeTitle" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NoticeBody" FontSize="12" Foreground="{StaticResource Secondary}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- CLAUDE CODE: live activity, done, waiting -->
                <Grid x:Name="AgentView" Width="380" Height="76" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AgentMascotHost" Width="40" Height="40" Margin="18,0,0,0" Background="Transparent" Cursor="Hand">
                        <local:Mascot x:Name="AgentMascot" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,24,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AgentProject" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" Text="Claude Code" />
                        <TextBlock x:Name="AgentActivity" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="Thinking…" />
                        <TextBlock x:Name="AgentDetail" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- CLAUDE CODE: permission request -->
                <Grid x:Name="ApproveView" Width="400" Height="156" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="18,16,18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Background="Transparent">
                                <local:Mascot x:Name="ApproveMascot" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ApproveProject" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ApproveTitle" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="10" Background="#1AFFFFFF" Height="38">
                            <TextBlock x:Name="ApproveDetail" FontFamily="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#DDFFFFFF" />
                        </Border>
                        <Grid Margin="0,10,0,0" Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DenyButton" CornerRadius="17" Background="{StaticResource Fill}" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                <TextBlock x:Name="DenyText" Text="Deny" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="AllowButton" Grid.Column="2" CornerRadius="17" Background="#30D158" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                <TextBlock x:Name="AllowText" Text="Allow" FontSize="13" FontWeight="SemiBold" Foreground="#06200F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ASK ABOUT A WINDOW: question in, answer out -->
                <Grid x:Name="AskView" Width="420" Height="240" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="18,14,18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="Transparent">
                                <local:Mascot x:Name="AskMascot" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AskHeading" FontSize="13.5" FontWeight="SemiBold" Text="Ask about this window" />
                                <TextBlock x:Name="AskTarget" FontSize="11" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border x:Name="AskClose" Grid.Column="2" Style="{StaticResource Circle}" Width="28" Height="28" CornerRadius="14" Background="{StaticResource Fill}">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE711;" />
                            </Border>
                        </Grid>
                        <Border x:Name="AskInputBox" Margin="0,10,0,0" CornerRadius="12" Background="#1AFFFFFF" Padding="10,0">
                            <Grid>
                                <TextBox x:Name="AskInput" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                         FontSize="13" Padding="0,8" VerticalContentAlignment="Center" />
                                <TextBlock x:Name="AskPlaceholder" IsHitTestVisible="False" FontSize="13" Foreground="#66FFFFFF" VerticalAlignment="Center"
                                           Text="What do you want to know? Press Enter" />
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="AskAnswerScroll" Margin="0,10,0,0" Height="122" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="AskAnswer" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="#E6FFFFFF" />
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <!-- MEDIA EXPANDED: now playing (compact, sleek) -->
                <Grid x:Name="MediaExpandedView" Width="360" Height="140" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="18,16,18,0">
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ExpandedArt" Width="46" Height="46" CornerRadius="12" Background="{StaticResource Fill}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                <TextBlock x:Name="ExpandedTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Not playing" />
                                <TextBlock x:Name="ExpandedArtist" FontSize="12" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="ExpandedBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform></Rectangle>
                                <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform></Rectangle>
                                <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform></Rectangle>
                                <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform></Rectangle>
                                <Rectangle Style="{StaticResource Bar}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform></Rectangle>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ProgressRow" Margin="0,12,0,0" Height="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" FontSize="10" FontWeight="Medium" Foreground="{StaticResource Secondary}"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Text="0:00" />
                            <Grid x:Name="ProgressTrack" Grid.Column="1" Height="3" VerticalAlignment="Center">
                                <Border CornerRadius="1.5" Background="#30FFFFFF" />
                                <Border x:Name="ProgressFill" CornerRadius="1.5" Background="#E6FFFFFF" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="10" FontWeight="Medium" Foreground="{StaticResource Secondary}"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right" Text="-0:00" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Border x:Name="PrevButton" Style="{StaticResource Circle}" Width="38" Height="38" CornerRadius="19" Background="Transparent">
                                <Path Fill="White" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M0,0 H2 V12 H0 Z M11,0 L3,6 L11,12 Z" StrokeLineJoin="Round" Stroke="White" StrokeThickness="1" />
                            </Border>
                            <Border x:Name="PlayButton" Style="{StaticResource Circle}" Width="42" Height="42" CornerRadius="21" Background="Transparent" Margin="22,0">
                                <Grid>
                                    <Path x:Name="PlayIcon" Fill="White" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" Data="M0,0 L12,7.5 L0,15 Z" />
                                    <Path x:Name="PauseIcon" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M1.5,0 H3.5 A1.5,1.5 0 0 1 5,1.5 V14.5 A1.5,1.5 0 0 1 3.5,16 H1.5 A1.5,1.5 0 0 1 0,14.5 V1.5 A1.5,1.5 0 0 1 1.5,0 Z M10.5,0 H12.5 A1.5,1.5 0 0 1 14,1.5 V14.5 A1.5,1.5 0 0 1 12.5,16 H10.5 A1.5,1.5 0 0 1 9,14.5 V1.5 A1.5,1.5 0 0 1 10.5,0 Z" />
                                </Grid>
                            </Border>
                            <Border x:Name="NextButton" Style="{StaticResource Circle}" Width="38" Height="38" CornerRadius="19" Background="Transparent">
                                <Path Fill="White" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M0,0 L8,6 L0,12 Z M9,0 H11 V12 H9 Z" StrokeLineJoin="Round" Stroke="White" StrokeThickness="1" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- TIMER EXPANDED / TIMER DONE -->
                <Grid x:Name="TimerExpandedView" Width="352" Height="76" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource TimerAccentDim}">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="20" Foreground="{StaticResource TimerAccent}" Text="&#xE916;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TimerCaption" FontSize="13" Foreground="{StaticResource Secondary}" Text="Timer" />
                            <TextBlock x:Name="TimerBig" FontFamily="{StaticResource Display}" FontSize="25" FontWeight="SemiBold" Margin="0,-3,0,0"
                                       Foreground="{StaticResource TimerAccent}" Typography.NumeralAlignment="Tabular" Text="4:59" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="TimerControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Border x:Name="TimerPauseButton" Style="{StaticResource Circle}" Background="{StaticResource TimerAccentDim}">
                            <TextBlock x:Name="TimerPauseGlyph" Style="{StaticResource Glyph}" FontSize="17" Foreground="{StaticResource TimerAccent}" Text="&#xE769;" />
                        </Border>
                        <Border x:Name="TimerCancelButton" Style="{StaticResource Circle}" Background="{StaticResource Fill}" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="15" Text="&#xE711;" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= MINIMAL BUBBLE (second activity) ================= -->
        <Border x:Name="Bubble" Background="#4B1F4D" Width="0" Height="0" CornerRadius="17" Canvas.Top="8" ClipToBounds="True">
            <Grid Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="22" Height="22" Stroke="{StaticResource TimerAccentDim}" StrokeThickness="3" />
                <Path x:Name="BubbleRing" Stroke="{StaticResource TimerAccent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
        </Border>
    </Canvas>
</Window>
